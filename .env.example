# Copy to .env — .env itself is gitignored.
#
# Base URL of the LexiPDF API (see prompt.md). Every path in the app is relative
# to it, so it must include the version segment.
#
#   Android emulator : http://10.0.2.2:3000/v1   (localhost is the emulator itself)
#   Physical device  : http://<your-lan-ip>:3000/v1
#   Production       : https://api.example.com/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
