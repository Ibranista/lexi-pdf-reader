+package com.github.barteksc.pdfviewer;
+
+import android.graphics.RectF;
+import android.util.SizeF;
+
+/** Uses the viewer's own layout, including mixed page sizes, spacing and zoom. */
+public final class SelectionGeometry {
+    public static RectF bounds(PDFView view, int page) {
+        if (view.isRecycled() || view.pdfFile == null || page < 0 || page >= view.getPageCount()) return null;
+        float zoom = view.getZoom();
+        SizeF size = view.pdfFile.getScaledPageSize(page, zoom);
+        float primary = view.pdfFile.getPageOffset(page, zoom);
+        float secondary = view.pdfFile.getSecondaryPageOffset(page, zoom);
+        float x = view.getCurrentXOffset() + (view.isSwipeVertical() ? secondary : primary);
+        float y = view.getCurrentYOffset() + (view.isSwipeVertical() ? primary : secondary);
+        return new RectF(x, y, x + size.getWidth(), y + size.getHeight());
+    }
+
+    public static int pageAt(PDFView view, float x, float y) {
+        if (view.isRecycled() || view.pdfFile == null) return -1;
+        float offset = view.isSwipeVertical() ? y - view.getCurrentYOffset() : x - view.getCurrentXOffset();
+        int page = view.pdfFile.getPageAtOffset(offset, view.getZoom());
+        RectF box = bounds(view, page);
+        return box != null && box.contains(x, y) ? page : -1;
+    }
+
+    /** First and last page index currently on screen, or null before load. */
+    public static int[] visiblePages(PDFView view) {
+        if (view.isRecycled() || view.pdfFile == null || view.getPageCount() == 0) return null;
+        float zoom = view.getZoom();
+        boolean vertical = view.isSwipeVertical();
+        float from = -(vertical ? view.getCurrentYOffset() : view.getCurrentXOffset());
+        float to = from + (vertical ? view.getHeight() : view.getWidth());
+        return new int[] { view.pdfFile.getPageAtOffset(from, zoom), view.pdfFile.getPageAtOffset(to, zoom) };
+    }
+
+    /** Scrolls like a finger drag would, loading pages that come into view. */
+    public static void scrollBy(PDFView view, float dy) {
+        if (view.isRecycled() || view.pdfFile == null) return;
+        view.moveRelativeTo(0, dy);
+        view.loadPageByOffset();
+    }
+
+    public static int documentPage(PDFView view, int page) {
+        return view.pdfFile == null ? -1 : view.pdfFile.documentPage(page);
+    }
+}
